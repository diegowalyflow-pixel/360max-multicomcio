# 360MAX Multicomercio — variables de entorno
# Copiar este archivo a .env y completar los valores reales.

PORT=4000
COMERCIO_ID=1
ADMIN_USUARIO=administrador
ADMIN_CLAVE=cambiar_esta_clave_segura
ADMIN_NOMBRE=Administrador

# DATABASE_URL de PostgreSQL (Render u otro proveedor)
# Ejemplo: postgres://usuario:clave@host:puerto/base?sslmode=require
DATABASE_URL=

# Si el comercio está al día con el pago (bloquea el panel si false)
PAGO_AL_DIA=true